# Rota da área da equipe (a 404 com a porta "moda"). Padrão: /atendente
VITE_STAFF_PATH=/atendente
# false = esconde dicas de agressão (botão "i" e hover) mesmo para usuária logada
VITE_SHOW_HINTS=true
# Deixe vazio (padrão): o site chama /api no próprio domínio (proxy do Cloudflare Pages / Vite).
# Só preencha se a API ficar em outro domínio; nesse caso ajuste CORS_ORIGINS na API e o
# connect-src do public/_headers.
VITE_API_URL=
