{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aep-4-semestre",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Mantém as variáveis criadas no painel (API_ORIGIN) em cada deploy.
  "keep_vars": true,
  // URL pública da API no Render (sem barra no fim). Não é segredo.
  "vars": { "API_ORIGIN": "https://saceourskin.onrender.com" },
  "assets": {
    "directory": "./dist",
    // Rotas do React Router (/entrar, /sacola, /atendente...) voltam para o index.html.
    "not_found_handling": "single-page-application",
    // Só /api/* passa pelo Worker (proxy para o Render); o resto é servido direto.
    "run_worker_first": ["/api/*"]
  }
}
